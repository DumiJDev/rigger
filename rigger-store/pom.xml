<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.rigger</groupId>
        <artifactId>rigger</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>rigger-store</artifactId>
    <name>Rigger Store</name>
    <description>State persistence layer. SQLite by default, PostgreSQL for HA. Schema managed by Flyway.</description>
    <dependencies>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-core</artifactId></dependency>
        <!-- For EventPersistenceListener: it listens to the in-memory event bus and writes rows.
             No cycle — rigger-events only depends on rigger-core. -->
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-events</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
        <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    </dependencies>
</project>