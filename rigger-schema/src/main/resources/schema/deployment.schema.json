{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigger.io/schema/v1/deployment",
  "title": "Rigger Deployment",
  "description": "Declares a replicated workload. Maps to a Docker Swarm replicated service.",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "rigger.io/v1"
    },
    "kind": {
      "type": "string",
      "const": "Deployment"
    },
    "metadata": {
      "$ref": "#/$defs/objectMeta"
    },
    "spec": {
      "type": "object",
      "required": [
        "image"
      ],
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0,
          "default": 1
        },
        "image": {
          "type": "string",
          "description": "Container image. E.g. myregistry/app:1.2.3"
        },
        "selector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object",
                "properties": {
                  "configMapKeyRef": {
                    "$ref": "#/$defs/keyRef"
                  },
                  "secretKeyRef": {
                    "$ref": "#/$defs/keyRef"
                  }
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "$ref": "#/$defs/resourceSet"
            },
            "requests": {
              "$ref": "#/$defs/resourceSet"
            }
          }
        },
        "strategy": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "RollingUpdate"
              ],
              "default": "RollingUpdate"
            },
            "maxUnavailable": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "delaySeconds": {
              "type": "integer",
              "minimum": 0,
              "default": 10
            },
            "failureAction": {
              "type": "string",
              "enum": [
                "PAUSE",
                "ROLLBACK",
                "CONTINUE"
              ],
              "default": "PAUSE"
            }
          }
        },
        "hpa": {
          "type": "object",
          "required": [
            "minReplicas",
            "maxReplicas"
          ],
          "properties": {
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 70
            },
            "targetMemoryUtilizationPercent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "scaleDownCooldownSeconds": {
              "type": "integer",
              "minimum": 0,
              "default": 180
            }
          }
        },
        "configMapRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secretRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "objectMeta": {
      "type": "object",
      "required": [
        "name",
        "namespace"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9\\-]{0,61}[a-z0-9]$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9\\-]{0,61}[a-z0-9]$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "keyRef": {
      "type": "object",
      "required": [
        "name",
        "key"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "key": {
          "type": "string"
        }
      }
    },
    "resourceSet": {
      "type": "object",
      "properties": {
        "cpu": {
          "type": "string",
          "examples": [
            "0.5",
            "1.0",
            "250m"
          ]
        },
        "memory": {
          "type": "string",
          "examples": [
            "256Mi",
            "512Mi",
            "1Gi"
          ]
        }
      }
    }
  }
}