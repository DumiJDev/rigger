<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent><groupId>io.rigger</groupId><artifactId>rigger</artifactId><version>1.0.0-SNAPSHOT</version></parent>
    <artifactId>rigger-server</artifactId>
    <name>Rigger Server</name>
    <description>Fat JAR: assembles all modules + embedded React UI into a single executable Spring Boot application.</description>
    <dependencies>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-core</artifactId></dependency>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-store</artifactId></dependency>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-manifest</artifactId></dependency>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-events</artifactId></dependency>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-schema</artifactId></dependency>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-swarm-adapter</artifactId></dependency>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-operator</artifactId></dependency>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-provisioner</artifactId></dependency>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-security</artifactId></dependency>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-api</artifactId></dependency>
        <dependency><groupId>io.rigger</groupId><artifactId>rigger-gitops</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
        <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
        <dependency><groupId>org.hibernate.orm</groupId><artifactId>hibernate-community-dialects</artifactId></dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution><goals><goal>repackage</goal></goals></execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
