<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.rigger</groupId>
    <artifactId>rigger</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Rigger</name>
    <description>Docker Swarm Operator — Secure by Design · 100% Java</description>

    <modules>
        <module>rigger-core</module>
        <module>rigger-store</module>
        <module>rigger-manifest</module>
        <module>rigger-events</module>
        <module>rigger-schema</module>
        <module>rigger-swarm-adapter</module>
        <module>rigger-provisioner</module>
        <module>rigger-security</module>
        <module>rigger-operator</module>
        <module>rigger-api</module>
        <module>rigger-gitops</module>
        <module>rigger-cli</module>
        <module>rigger-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.3.5</spring-boot.version>
        <sqlite-jdbc.version>3.46.1.3</sqlite-jdbc.version>
        <flyway.version>10.20.1</flyway.version>
        <jackson.version>2.18.0</jackson.version>
        <snakeyaml.version>2.3</snakeyaml.version>
        <mina-sshd.version>2.13.2</mina-sshd.version>
        <okhttp.version>4.12.0</okhttp.version>
        <picocli.version>4.7.6</picocli.version>
        <lombok.version>1.18.34</lombok.version>
        <junit.version>5.11.3</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <testcontainers.version>1.20.3</testcontainers.version>
        <awaitility.version>4.2.2</awaitility.version>
        <wiremock.version>3.9.2</wiremock.version>
        <jjwt.version>0.12.6</jjwt.version>
        <json-schema-validator.version>1.5.1</json-schema-validator.version>
        <jgit.version>6.10.0.202406032230-r</jgit.version>
        <mockwebserver.version>4.12.0</mockwebserver.version>
        <maven-shade.version>3.6.0</maven-shade.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-manifest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-schema</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-swarm-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-provisioner</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-operator</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-gitops</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-annotations</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-core</artifactId>
                <version>${mina-sshd.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-sftp</artifactId>
                <version>${mina-sshd.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${awaitility.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock</artifactId>
                <version>${wiremock.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <parameters>true</parameters>
                        <compilerArgs><arg>--enable-preview</arg></compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.1</version>
                    <configuration>
                        <argLine>--enable-preview</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
