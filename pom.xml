<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.rigger</groupId>
    <artifactId>rigger</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Rigger</name>
    <description>Docker Swarm Operator — Secure by Design · 100% Java</description>

    <modules>
        <module>rigger-core</module>
        <module>rigger-store</module>
        <module>rigger-manifest</module>
        <module>rigger-events</module>
        <module>rigger-schema</module>
        <module>rigger-swarm-adapter</module>
        <module>rigger-provisioner</module>
        <module>rigger-security</module>
        <module>rigger-operator</module>
        <module>rigger-api</module>
        <module>rigger-gitops</module>
        <module>rigger-cli</module>
        <module>rigger-server</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring Boot 4 (Framework 7 / Security 7). Brings Jackson 3, whose databind moved from
             com.fasterxml.jackson.databind to tools.jackson.databind — the annotations
             (com.fasterxml.jackson.annotation.*) are unchanged, so the domain records keep their
             @JsonProperty imports. -->
        <spring-boot.version>4.1.0</spring-boot.version>
        <sqlite-jdbc.version>3.51.1.0</sqlite-jdbc.version>
        <flyway.version>13.2.0</flyway.version>
        <mina-sshd.version>2.16.0</mina-sshd.version>
        <okhttp.version>4.12.0</okhttp.version>
        <picocli.version>4.7.7</picocli.version>
        <lombok.version>1.18.42</lombok.version>
        <jjwt.version>0.13.0</jjwt.version>
        <json-schema-validator.version>1.5.9</json-schema-validator.version>
        <jgit.version>7.5.0.202511071551-r</jgit.version>
        <maven-shade.version>3.6.0</maven-shade.version>
        <!-- docker-java 3.3.6 was built/tested against httpclient5 5.0.3, but Spring Boot's own
             BOM manages a much newer httpclient5 (5.5.x) that Spring's HTTP client
             autoconfiguration itself requires. Mixing them corrupted docker-java's Unix-socket
             connection pool after enough requests (calls started hitting a bogus
             "unix://localhost:2375" route). docker-java 3.7.1 bundles httpclient5 5.5.1 — close
             enough to Spring's managed version to avoid the conflict entirely. -->
        <docker-java.version>3.7.1</docker-java.version>

        <!-- Angular console build, wired into rigger-server. The leading "v" on node.version is
             mandatory: frontend-maven-plugin's NodeInstaller rejects a version without it.
             npm is whatever ships with that Node — pinning the Node version makes it deterministic
             anyway, and the plugin does not read package.json's "packageManager" field.
             Set -Dui.skip=true to build the backend without running npm (see CLAUDE.md). -->
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <node.version>v24.15.0</node.version>
        <ui.skip>false</ui.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-manifest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-schema</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-swarm-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-provisioner</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-operator</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-gitops</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rigger</groupId>
                <artifactId>rigger-cli</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <!-- Jackson versions come from the Spring Boot BOM (Jackson 3 under Boot 4);
                 pinning them here would fight the BOM and risk a databind/annotations split. -->
            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-core</artifactId>
                <version>${mina-sshd.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.sshd</groupId>
                <artifactId>sshd-sftp</artifactId>
                <version>${mina-sshd.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <!-- JUnit, Mockito and Awaitility are managed by the imported Spring Boot BOM and are
                 deliberately not re-declared here: a versionless entry in this block shadows the
                 BOM's own entry instead of inheriting it, which breaks every module's test scope.
                 Testcontainers and WireMock used to be declared here but no module ever used them. -->
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                </plugin>
                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>${frontend-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>${maven-clean-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
